{
  "name": "@singlespark/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pons": "node scripts/robinhood/launchpads/pons/testnet/build.mjs",
    "test:pons": "node --test --test-concurrency=1 scripts/robinhood/launchpads/pons/testnet/*.test.mjs",
    "test:pons:fork": "node scripts/robinhood/launchpads/pons/testnet/rehearse.mjs",
    "deploy:pons:testnet": "node scripts/robinhood/launchpads/pons/testnet/deploy.mjs",
    "verify:pons:testnet": "node scripts/robinhood/launchpads/pons/testnet/verify.mjs",
    "test:pons:vault": "forge test --root chains/robinhood",
    "deploy:pons:vault": "node scripts/robinhood/launchpads/pons/testnet/deploy-vault.mjs",
    "check:architecture": "node --test --test-concurrency=1 architecture.test.mjs",
    "test:tools": "node --test --test-concurrency=1 scripts/arc/shared/*.test.mjs scripts/robinhood/launchpads/pons/testnet/*.test.mjs"
  },
  "dependencies": {
    "viem": "2.57.3"
  }
}
