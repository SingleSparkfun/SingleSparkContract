{
  "name": "@singlespark/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pons": "node scripts/robinhood/launchpads/pons/testnet/build.mjs",
    "test:pons": "node --test --test-concurrency=1 scripts/robinhood/launchpads/pons/testnet/*.test.mjs",
    "test:pons:fork": "node scripts/robinhood/launchpads/pons/testnet/rehearse.mjs",
    "deploy:pons:testnet": "node scripts/robinhood/launchpads/pons/testnet/deploy.mjs",
    "verify:pons:testnet": "node scripts/robinhood/launchpads/pons/testnet/verify.mjs",
    "test:pons:vault": "forge test --threads 2 --root chains/robinhood",
    "deploy:pons:vault": "node scripts/robinhood/launchpads/pons/testnet/deploy-vault.mjs",
    "check:architecture": "node --test --test-concurrency=1 architecture.test.mjs",
    "test:tools": "node --test --test-concurrency=1 scripts/arc/shared/*.test.mjs scripts/arc/launchpads/argus/testnet/*.test.mjs scripts/robinhood/launchpads/pons/testnet/*.test.mjs",
    "build:platform:nft": "FOUNDRY_PROFILE=platform forge build --root chains/robinhood --sizes",
    "test:platform:nft": "FOUNDRY_PROFILE=platform forge test --threads 2 --root chains/robinhood",
    "prepare:platform:nft:randomness": "node scripts/robinhood/platform/testnet/prepare-openvrf.mjs",
    "test:platform:nft:tools": "node --test --test-concurrency=2 scripts/robinhood/platform/testnet/*.test.mjs",
    "test:platform:nft:randomness:local": "node scripts/robinhood/platform/testnet/check-random-nft-local.mjs",
    "deploy:platform:nft:testnet": "node scripts/robinhood/platform/testnet/deploy-nft-vault.mjs",
    "verify:platform:nft:testnet": "node scripts/robinhood/platform/testnet/verify-nft-vault.mjs"
  },
  "dependencies": {
    "viem": "2.57.3"
  }
}
